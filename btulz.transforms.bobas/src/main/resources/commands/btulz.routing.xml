<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!DOCTYPE CommandBuilder>
<ns2:CommandBuilder Description="查询已注册模块生成路由文件"
    xmlns:ns2="http://colorcoding.org/btulz/shell/commands">
    <Item Name="Java" Content="java" Editable="false" />
    <Item Name="JarOption" Content="-jar" Description="执行jar包" Editable="false" />
    <Item Name="Application" Content="btulz.transforms.bobas-0.2.0.jar" Description="包名称" Editable="false" />
    <Item Name="Command" Content="routing" Description="子命令" Editable="false" />
    <Item Name="Config" Content="-config=${VALUE}" Description="业务仓库配置文件">
        <ValidValues Rule="file" />
    </Item>
    <Item Name="Query" Content="-query=${VALUE}" Description="查询" Value="SELECT * FROM ${Company}_SYS_MODULE"/>
    <Item Name="DataUrl" Content="-dataUrl=${VALUE}" Description="数据地址" Value=".../${ModuleName}/services/rest/data"/>
    <Item Name="ViewUrl" Content="-viewUrl=${VALUE}" Description="视图地址" Value=".../${ModuleName}/"/>
    <Item Name="Output" Content="-out=${VALUE}" Description="输出路径" Value="${WORK_FOLDER}temp/service_routing.xml">
        <ValidValues Rule="file"/>
    </Item>
    <Item Name="Ignore" Content="-ignore" Description="忽略错误" Editable="false" Optional="true" />
</ns2:CommandBuilder>
