<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!DOCTYPE CommandBuilder>
<ns2:CommandBuilder Description="创建数据结构" DefinitionItem="DbType"
    xmlns:ns2="http://colorcoding.org/btulz/shell/commands">
    <Item Name="Java" Content="java" Editable="false" />
    <Item Name="JarOption" Content="-jar" Description="执行jar包" Editable="false" />
    <Item Name="Application" Content="btulz.transforms.core-0.2.0.jar" Description="包名称" Editable="false" />
    <Item Name="Command" Content="ds" Description="子命令" Editable="false" />
    <Item Name="DbType" Description="数据库类型" Value="MSSQL" Editable="false">
        <ValidValues Rule="features" Definitions="commands/validvalues.database.xml"/>
    </Item>
    <Item Name="DsTemplate" Content="-templateFile=${VALUE}" Description="使用的模板" />
    <Item Name="Company" Content="-company=${VALUE}" Description="公司" Value="CC" />
    <Item Name="DbServer" Content="-dbServer=${VALUE}" Description="数据库地址" />
    <Item Name="DbPort" Content="-dbPort=${VALUE}" Description="数据库端口" />
    <Item Name="DbSchema" Content="-dbSchema=${VALUE}" Description="数据库架构" />
    <Item Name="DbName" Content="-dbName=${VALUE}" Description="数据库名称" Value="ibas_demo" />
    <Item Name="DbUser" Content="-dbUser=${VALUE}" Description="用户" />
    <Item Name="DbPassword" Content="-dbPassword=${VALUE}" Description="密码" Value="1q2w3e" />
    <Item Name="Domains" Content="-domains=${VALUE}" Description="模型文件" Value="${WORK_FOLDER}domains">
        <ValidValues Rule="file" />
    </Item>
</ns2:CommandBuilder>
