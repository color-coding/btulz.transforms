<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!DOCTYPE CommandBuilder>
<ns2:CommandBuilder Description="SQL转XML"
    xmlns:ns2="http://colorcoding.org/btulz/shell/commands">
    <Item Name="Java" Content="java" Editable="false" />
    <Item Name="JarOption" Content="-jar" Description="执行jar包" Editable="false" />
    <Item Name="Application" Content="btulz.transforms.core-0.2.0.jar" Description="包名称" Editable="false" />
    <Item Name="Command" Content="sql2xml" Description="子命令" Editable="false" />
    <Item Name="DbType" Content="-DbType=${VALUE}" Description="数据库类型" Value="HANA" Editable="false">
        <ValidValues Rule="features" Definitions="commands/validvalues.database.xml"/>
    </Item>
    <Item Name="SqlFile" Content="-SqlFile=${VALUE}" Description="SQL文件或目录" Value="${WORK_FOLDER}initialization">
        <ValidValues Rule="file" />
    </Item>
    <Item Name="OutputFile" Content="-OutputFile=${VALUE}" Description="输出文件或目录" Optional="true">
        <ValidValues Rule="file" />
    </Item>
    <Item Name="StatementCount" Content="-StatementCount=${VALUE}" Description="每个XML包含的语句数" Value="-1" Optional="true" />
</ns2:CommandBuilder>
