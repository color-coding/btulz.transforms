<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!DOCTYPE CommandBuilder>
<ns2:CommandBuilder Description="生成代码"
    xmlns:ns2="http://colorcoding.org/btulz/shell/commands">
    <Item Name="Java" Content="java" Editable="false" />
    <Item Name="Encoding" Content="-Dfile.encoding=utf-8" Description="使用utf-8编码方式" Editable="false" />
    <Item Name="JarOption" Content="-jar" Description="执行jar包" Editable="false" />
    <Item Name="Application" Content="btulz.transforms.core-0.2.0.jar" Description="包名称" Editable="false" />
    <Item Name="Command" Content="code" Description="子命令" Editable="false" />
    <Item Name="TemplateFolder" Content="-TemplateFolder=${VALUE}" Description="使用的模板">
        <ValidValues Rule="template" Definitions="Template=code;WorkFile=btulz.transforms.core-0.2.0.jar;WorkFile=" />
    </Item>
    <Item Name="OutputFolder" Content="-OutputFolder=${VALUE}" Description="输出目录" Value="${WORK_FOLDER}temp">
        <ValidValues Rule="file"/>
    </Item>
    <Item Name="GroupId" Content="-GroupId=${VALUE}" Description="组标记" Value="org.colorcoding" />
    <Item Name="ArtifactId" Content="-ArtifactId=${VALUE}" Description="项目标记" Value="ibas" />
    <Item Name="ProjectVersion" Content="-ProjectVersion=${VALUE}" Description="项目标记" Value="0.1.0" />
    <Item Name="ProjectUrl" Content="-ProjectUrl=${VALUE}" Description="项目地址" Value="http://colorcoding.org" />
    <Item Name="Domains" Content="-Domains=${VALUE}" Description="模型文件" Value="${WORK_FOLDER}domains">
        <ValidValues Rule="file"/>
    </Item>
    <Item Name="Parameters" Content="-Parameters=[${VALUE}]" Description="其他参数">
        <Items>
            <Item Name="Company" Content="{&quot;name&quot;:&quot;Company&quot;,&quot;value&quot;:&quot;${VALUE}&quot;}" Description="公司标识" Value="CC" />
            <Item Name="Copyright" Content=",{&quot;name&quot;:&quot;Copyright&quot;,&quot;value&quot;:&quot;${VALUE}&quot;}" Description="版权声明" Value="Color-Coding Studio" />
            <Item Name="ibasVersion" Content=",{&quot;name&quot;:&quot;ibasVersion&quot;,&quot;value&quot;:&quot;${VALUE}&quot;}" Description="ibas版本" Value="0.2.0" />
            <Item Name="ibasIfVersion" Content=",{&quot;name&quot;:&quot;ibasIfVersion&quot;,&quot;value&quot;:&quot;${VALUE}&quot;}" Description="最初模块版本" Value="0.2.0" />
            <Item Name="ProjectId" Content=",{&quot;name&quot;:&quot;ProjectId&quot;,&quot;value&quot;:&quot;${VALUE}&quot;}" Description="项目标识">
                <ValidValues Rule="uuid"/>
            </Item>
        </Items>
    </Item>
    <Item Name="Release" Content="-Release" Description="释放资源" Editable="false" Optional="true" />
</ns2:CommandBuilder>
